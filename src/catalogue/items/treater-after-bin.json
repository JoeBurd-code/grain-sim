{
  "id": "treater-after-bin",
  "version": 1,
  "name": "Treater after-bin",
  "group": "storage",
  "maker": "",
  "model": "",
  "machine": {
    "type": "bin",
    "w": 80,
    "h": 80,
    "ports": {
      "inputs": [
        "in"
      ],
      "outputs": [
        "out"
      ]
    },
    "anchors": {
      "in": {
        "x": 40,
        "y": 0
      },
      "out": {
        "x": 40,
        "y": 80
      }
    },
    "fill": 0,
    "instruments": [
      "LSH",
      "LSL"
    ],
    "label": {
      "side": "left",
      "align": "center"
    },
    "params": [
      {
        "id": "level",
        "label": "fill level",
        "min": 0,
        "max": 100,
        "value": 0,
        "unit": "%",
        "bind": "levelJump"
      }
    ],
    "setpointSliders": [
      {
        "switch": "LSH",
        "label": "LSH0 set point",
        "min": 30,
        "max": 100
      },
      {
        "switch": "LSL",
        "label": "LSL0 clear point",
        "min": 0,
        "max": 30
      }
    ],
    "adjustable": [
      {
        "id": "capacity",
        "label": "capacity",
        "unit": "m³",
        "kind": "number",
        "min": 0.2,
        "max": 2,
        "default": 0.67,
        "bind": "capacity"
      }
    ],
    "sim": {
      "kind": "accumulator",
      "capacityM3": 0.67
    }
  }
}
