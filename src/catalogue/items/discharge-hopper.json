{
  "id": "discharge-hopper",
  "version": 1,
  "name": "Screen discharge hopper",
  "group": "storage",
  "maker": "",
  "model": "",
  "machine": {
    "type": "bin",
    "w": 60,
    "h": 46,
    "ports": {
      "inputs": [
        "in"
      ],
      "outputs": [
        "out"
      ]
    },
    "anchors": {
      "in": {
        "x": 30,
        "y": 0
      },
      "out": {
        "x": 30,
        "y": 46
      }
    },
    "fill": 0,
    "instruments": [
      "LSH"
    ],
    "label": {
      "side": "right",
      "align": "center"
    },
    "params": [
      {
        "id": "level",
        "label": "fill level",
        "min": 0,
        "max": 100,
        "value": 0,
        "unit": "%",
        "bind": "levelJump"
      }
    ],
    "adjustable": [
      {
        "id": "capacity",
        "label": "capacity",
        "unit": "m³",
        "kind": "number",
        "min": 0.05,
        "max": 0.6,
        "default": 0.2,
        "bind": "capacity"
      }
    ],
    "sim": {
      "kind": "accumulator",
      "capacityM3": 0.2
    }
  }
}
