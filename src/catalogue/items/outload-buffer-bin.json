{
  "id": "outload-buffer-bin",
  "version": 1,
  "name": "Outload buffer bin",
  "group": "storage",
  "maker": "",
  "model": "",
  "machine": {
    "type": "bin",
    "w": 130,
    "h": 145,
    "ports": {
      "inputs": [
        "in"
      ],
      "outputs": [
        "out"
      ]
    },
    "anchors": {
      "in": {
        "x": 30,
        "y": 0
      },
      "out": {
        "x": 65,
        "y": 145
      }
    },
    "fill": 0,
    "instruments": [
      "LSH",
      "LSL"
    ],
    "label": {
      "side": "left",
      "align": "center"
    },
    "params": [
      {
        "id": "level",
        "label": "fill level",
        "min": 0,
        "max": 100,
        "value": 0,
        "unit": "%",
        "bind": "levelJump"
      }
    ],
    "adjustable": [
      {
        "id": "capacity",
        "label": "capacity",
        "unit": "m³",
        "kind": "number",
        "min": 1,
        "max": 15,
        "default": 4.51,
        "bind": "capacity"
      }
    ],
    "sim": {
      "kind": "accumulator",
      "capacityM3": 4.51
    }
  }
}
